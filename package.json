{
  "name": "bloom-wars",
  "private": true,
  "version": "0.9.0",
  "description": "The Bloom Wars — a browser tactics RPG, Early Access build.",
  "author": "TSNL",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:demo": "node tools/lint-spoiler.mjs && node tools/lint-cast-collision.mjs && tsc && vite build --mode demo",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "sim": "tsx src/sim/run.ts",
    "sim:social": "tsx src/sim/runSocialSim.ts",
    "sim:gate": "tsx src/sim/runGateVerification.ts",
    "sim:batch": "tsx src/sim/runBatch.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tools/lint-spoiler.mjs && node tools/lint-cast-collision.mjs",
    "pretest": "node tools/lint-spoiler.mjs && node tools/lint-cast-collision.mjs",
    "prebuild": "node tools/lint-spoiler.mjs && node tools/lint-cast-collision.mjs",
    "sim:recroom": "tsx src/sim/runRecRoomSim.ts",
    "sim:economy": "tsx src/sim/runFrameSystemsEconomySim.ts",
    "sim:brain": "tsx src/sim/runBrainSim.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "build": {
    "appId": "com.bloomwars.thebloomwars",
    "productName": "The Bloom Wars",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
