{
  "name": "bloom-wars",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "tsx src/sim/run.ts",
    "sim:social": "tsx src/sim/runSocialSim.ts",
    "sim:gate": "tsx src/sim/runGateVerification.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tools/lint-spoiler.mjs",
    "pretest": "node tools/lint-spoiler.mjs",
    "prebuild": "node tools/lint-spoiler.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
